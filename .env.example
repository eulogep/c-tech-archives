# Environnement Django : development, test ou production
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-unique-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL
POSTGRES_DB=c_tech_archives
POSTGRES_USER=c_tech_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Fichiers : valeurs provisoires à valider avec C-Tech
# Les documents restent hors de MEDIA_URL et ne doivent pas être versionnés.
PRIVATE_MEDIA_ROOT=private_media
ARCHIVE_MAX_UPLOAD_SIZE=10485760
ARCHIVE_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.txt,.jpg,.jpeg,.png

# Production : n'activer ces options qu'après la configuration et le test de HTTPS
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_USE_X_FORWARDED_PROTO=False
