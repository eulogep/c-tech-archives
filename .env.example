# Environnement Django : development, test ou production
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-unique-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL
POSTGRES_DB=c_tech_archives
POSTGRES_USER=c_tech_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Fichiers : valeurs provisoires à valider avec C-Tech
# Les documents restent hors de MEDIA_URL et ne doivent pas être versionnés.
PRIVATE_MEDIA_ROOT=private_media
ARCHIVE_MAX_UPLOAD_SIZE=10485760
ARCHIVE_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.txt,.jpg,.jpeg,.png

# Comptes privilégiés : renseigner uniquement dans .env ou l’environnement d’exécution.
# Les valeurs réelles ne doivent jamais être versionnées ni affichées par la commande.
CTECH_STEVEN_EMAIL=business-administrator@example.invalid
CTECH_STEVEN_PASSWORD=replace-with-a-strong-business-administrator-password
CTECH_EULOGE_EMAIL=technical-administrator@example.invalid
CTECH_EULOGE_PASSWORD=replace-with-a-strong-technical-administrator-password

# Démarrage Render : le bootstrap crée les comptes manquants sans jamais modifier
# un compte existant. Mettre à True le temps d'un déploiement pour réaligner.
CTECH_BOOTSTRAP_RECONCILE=False

# Jeu de démonstration local (python manage.py seed_demo), refusé en production.
CTECH_DEMO_PASSWORD=replace-with-a-strong-demo-password

# Limitation des tentatives (valeurs par défaut)
CTECH_LOGIN_FAILURE_LIMIT=5
CTECH_LOGIN_LOCKOUT_SECONDS=900
CTECH_SIGNUP_LIMIT=10
CTECH_SIGNUP_WINDOW_SECONDS=3600

# Session (8 h) et journalisation console
DJANGO_SESSION_COOKIE_AGE=28800
DJANGO_LOG_LEVEL=INFO
# database (production, partagé entre workers) ou locmem (développement)
# DJANGO_CACHE_BACKEND=locmem

# Production : n'activer ces options qu'après la configuration et le test de HTTPS
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_USE_X_FORWARDED_PROTO=False
